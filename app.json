{
  "expo": {
    "name": "Long Take",
    "slug": "long-take",
    "owner": "netlinko",
    "scheme": [
      "framevane",
      "longtake"
    ],
    "version": "1.0.0",
    "newArchEnabled": true,
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "runtimeVersion": "1.0.0",
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E1319"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "newArchEnabled": true,
      "supportsTablet": true,
      "bundleIdentifier": "app.longtake"
    },
    "android": {
      "newArchEnabled": true,
      "package": "app.longtake",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0E1319"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Framevane uses the camera to broadcast what you are filming.",
          "microphonePermission": "Framevane uses the microphone to broadcast sound with the picture.",
          "recordAudioAndroid": true
        }
      ],
      "./plugins/with-backup-rules"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "sentryDsn": ""
    }
  }
}