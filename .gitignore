expo-env.d.ts
# @end expo-cli

# Anchored to the project root ON PURPOSE. Bare `android` and `ios` match a
# directory of that name at ANY depth, which quietly swallowed the native half
# of modules/framevane-broadcaster - so the APK shipped the JavaScript calling
# requireNativeModule and none of the Kotlin behind it, and crashed on launch
# with "Cannot find native module". These entries are for prebuild output only.
/android
/ios
notes.txt
